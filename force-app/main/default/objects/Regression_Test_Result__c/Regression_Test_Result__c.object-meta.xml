<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Stores the outcome of an individual test case within a regression test run, including pass/fail status, error details, and execution log.</description>
    <enableActivities>false</enableActivities>
    <enableReports>true</enableReports>
    <label>Regression Test Result</label>
    <nameField>
        <displayFormat>RES-{0000}</displayFormat>
        <label>Result Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Regression Test Results</pluralLabel>
    <sharingModel>ControlledByParent</sharingModel>
</CustomObject>
