<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Error_Message_Required_For_Failed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &apos;Failed&apos;), ISBLANK(Error_Message__c))</errorConditionFormula>
    <errorDisplayField>Error_Message__c</errorDisplayField>
    <errorMessage>Error Message is required when status is Failed.</errorMessage>
</ValidationRule>
