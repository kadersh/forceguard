<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Steps_Required_For_Data_Scenario</fullName>
    <active>true</active>
    <errorConditionFormula>AND(ISPICKVAL(Test_Layer__c, 'Data Scenario'), ISBLANK(Steps__c))</errorConditionFormula>
    <errorDisplayField>Steps__c</errorDisplayField>
    <errorMessage>Steps are required for Data Scenario test cases.</errorMessage>
</ValidationRule>
